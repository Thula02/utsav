# Neon connection string. Keep the "+psycopg" part and "sslmode=require".
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any OpenAI-compatible provider. Groq example (check the provider docs for the current model name):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Gemini example:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash

# 1 = never call the LLM (uses the built-in sample plan and a simple regex summariser). Use for safe demos.
DEMO_MODE=0

# Comma-separated list of frontend URLs allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in guest invite links). Defaults to the first ALLOWED_ORIGINS entry.
FRONTEND_URL=http://localhost:5173
